{
    "name": "meil/meil-php",
    "description": "Official PHP client for the meil.ro email API: transactional email and newsletters.",
    "type": "library",
    "license": "MIT",
    "keywords": ["meil", "email", "transactional-email", "newsletter", "ses", "api"],
    "homepage": "https://meil.ro/docs",
    "authors": [
        {"name": "meil.ro", "homepage": "https://meil.ro"}
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {"Meil\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Meil\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:live": "phpunit --testsuite live",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
